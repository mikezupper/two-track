{
  "name": "two-track",
  "version": "0.1.0",
  "description": "Zero-dependency railway-oriented programming for TypeScript: Result, Option, decoders, exhaustive match, and async combinators that keep the algebra at compile time.",
  "license": "MIT",
  "author": "Mike Zupper",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./result": {
      "types": "./dist/result.d.ts",
      "import": "./dist/result.js",
      "default": "./dist/result.js"
    },
    "./option": {
      "types": "./dist/option.d.ts",
      "import": "./dist/option.js",
      "default": "./dist/option.js"
    },
    "./decode": {
      "types": "./dist/decode.d.ts",
      "import": "./dist/decode.js",
      "default": "./dist/decode.js"
    },
    "./async": {
      "types": "./dist/async.d.ts",
      "import": "./dist/async.js",
      "default": "./dist/async.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities.d.ts",
      "import": "./dist/capabilities.js",
      "default": "./dist/capabilities.js"
    },
    "./lanes": {
      "types": "./dist/lanes.d.ts",
      "import": "./dist/lanes.js",
      "default": "./dist/lanes.js"
    },
    "./tagged": {
      "types": "./dist/tagged.d.ts",
      "import": "./dist/tagged.js",
      "default": "./dist/tagged.js"
    },
    "./match": {
      "types": "./dist/match.d.ts",
      "import": "./dist/match.js",
      "default": "./dist/match.js"
    },
    "./fn": {
      "types": "./dist/fn.d.ts",
      "import": "./dist/fn.js",
      "default": "./dist/fn.js"
    },
    "./brand": {
      "types": "./dist/brand.d.ts",
      "import": "./dist/brand.js",
      "default": "./dist/brand.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/fix-dts-extensions.ts",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint-invariants.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "bench": "node bench/encodings.ts",
    "bench:hot": "node bench/hot-paths.ts",
    "bench:bundle": "node bench/bundles.mjs && node bench/bundles.mjs --bundler esbuild",
    "check:bundle": "node bench/bundles.mjs --check && node bench/bundles.mjs --bundler esbuild --check",
    "check": "pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm bench:check && pnpm check:lanes && pnpm build && pnpm check:bundle && pnpm check:package && pnpm check:tools",
    "example": "node examples/checkout.ts",
    "bench:check": "node bench/encodings.ts --check",
    "check:tools": "pnpm -r --filter two-track-check check",
    "check:package": "node scripts/check-package.mjs",
    "bench:cross": "pnpm --filter two-track-bench-cross bench",
    "bench:lanes": "node bench/lanes.ts",
    "check:lanes": "node bench/lanes.ts --check",
    "prepare": "node -e \"process.exit(require('fs').existsSync('dist/index.js')?0:1)\" 2>/dev/null || pnpm build",
    "bench:record": "node scripts/record-measurements.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "0.28.0",
    "fast-check": "^4.10.2",
    "rolldown": "1.2.12",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikezupper/two-track.git"
  },
  "homepage": "https://github.com/mikezupper/two-track#readme",
  "bugs": {
    "url": "https://github.com/mikezupper/two-track/issues"
  },
  "keywords": [
    "result",
    "option",
    "railway-oriented",
    "functional",
    "typescript",
    "zero-dependency",
    "decoder",
    "parse-dont-validate"
  ]
}
